{
  "version": 2,
  "name": "snack-bestelsysteem",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/bestellen", "destination": "/snack-order.html" },
    { "source": "/beheer",    "destination": "/snack-admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
